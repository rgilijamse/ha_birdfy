# Decompiler image for reverse engineering the Birdfy Android app.
#   podman build -t ha-birdfy-jadx -f tools/Containerfile.jadx tools/
#   podman run --rm -v "$PWD/apk":/apk ha-birdfy-jadx \
#       jadx -d /apk/src --no-res /apk/birdfy.APK
FROM docker.io/library/eclipse-temurin:21-jdk

ARG JADX_VERSION=1.5.6
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
 && curl -sSL -o /tmp/jadx.zip \
      "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip" \
 && unzip -q /tmp/jadx.zip -d /opt/jadx && rm /tmp/jadx.zip \
 && ln -s /opt/jadx/bin/jadx /usr/local/bin/jadx \
 && rm -rf /var/lib/apt/lists/*
